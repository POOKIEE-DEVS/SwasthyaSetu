# Root environment for docker-compose -- copy to .env to override.
# These defaults are for local development only; anything
# production-plausible must never be written here.

POSTGRES_USER=swasthyasetu
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=swasthyasetu

# Shared secret used by coturn and the backend to mint short-lived TURN
# credentials. Both must agree, which is why it lives here rather than in
# backend/.env.example alone.
TURN_USERNAME=swasthyasetu
TURN_CREDENTIAL=dev-only-turn-secret

# Per-service configuration is documented in each service's own
# .env.example (backend/, frontend/).
