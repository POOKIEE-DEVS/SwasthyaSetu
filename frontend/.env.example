# SwasthyaSetu frontend -- copy to .env.local and adjust for your machine.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.
# Everything the browser needs is public by definition, so no secret may
# ever be given this prefix.

# Backend REST API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket origin for consultation signalling, notifications, and the
# doctor queue. wss:// in any deployed environment.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
