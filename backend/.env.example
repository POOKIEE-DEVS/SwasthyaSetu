# SwasthyaSetu backend -- copy to backend/.env for local runs.
# backend/.env is gitignored. On Render, set these in the dashboard instead.

# --- AI model: your MedGemma Space (see model-space/ and docs/deployment.md)
# Space id ("username/space-name") or its full URL.
HF_SPACE_ID=
# Read token for a PRIVATE Space. Never commit it.
HF_TOKEN=
MODEL_TIMEOUT_SECONDS=120

# --- Video calls: TURN relay, needed when the two laptops are on different
# networks. Option A (recommended): Cloudflare Realtime TURN.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B: any TURN provider with static credentials (e.g. Metered).
# Comma-separated URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Local development
# Only needed when `npm run dev` serves the frontend on :3000.
CORS_ORIGINS=http://localhost:3000
# Serve a built frontend from the backend (after `npm run build` in frontend/).
STATIC_DIR=../frontend/out
LOG_LEVEL=INFO
