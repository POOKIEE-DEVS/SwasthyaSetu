# SwasthyaSetu backend -- copy to backend/.env for local runs, then
#   cd backend && go run ./cmd/server
# The server reads .env from the directory it runs in; real environment
# variables win. backend/.env is gitignored. On Render, set these in the
# dashboard instead.

# --- AI model: your MedGemma Space (see model-space/ and docs/deployment.md)
# Space id ("username/space-name"), or the full URL of a running copy, e.g.
# the https://….gradio.live link printed by model-space/colab.ipynb.
HF_SPACE_ID=
# Read token for a PRIVATE Space. Leave empty for a gradio.live URL. Never commit it.
HF_TOKEN=
MODEL_TIMEOUT_SECONDS=120

# --- Video calls: TURN relay, needed when the two laptops are on different
# networks. Fill in ONE option.
# Option A (free, no card): static credentials, e.g. ExpressTURN's free plan.
# Comma-separated URLs, e.g.
# turn:HOST:3478,turn:HOST:3478?transport=tcp,turn:HOST:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Option B: Cloudflare Realtime TURN (1,000 GB/month free, card on file).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Accounts, verification and chat history
# Postgres in production (Neon or Supabase connection string). Locally the
# default is a SQLite file, so this can stay commented out.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sign in with Google (OAuth client from Google Cloud Console)
# Authorized redirect URI: <site>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google account email(s) of the admin who reviews applications.
ADMIN_EMAILS=
# Sign in without Google, for local testing and the smoke test. Always off
# when ENVIRONMENT=production.
DEV_LOGIN=true

# --- Local development
# Only needed when `npm run dev` serves the frontend on :3000.
CORS_ORIGINS=http://localhost:3000
# Serve a built frontend from the backend (after `npm run build` in frontend/).
STATIC_DIR=../frontend/out
# PORT=8000
LOG_LEVEL=INFO
# One JSON object per log line, for a log aggregator.
# LOG_JSON=true
