# SwasthyaSetu backend -- copy to .env and adjust for your machine.
# Every value here is a non-secret default or an obvious placeholder;
# never commit a real .env.

# --- Application ---
ENVIRONMENT=development
SERVICE_NAME=backend
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Emit one JSON object per log line. Leave false locally, true in production.
LOG_JSON=false
# Comma-separated; the Next.js dev server in development.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Note the +asyncpg driver. Alembic and Celery derive the sync URL from this.
DATABASE_URL=postgresql+asyncpg://swasthyasetu:changeme-in-local-env@localhost:5432/swasthyasetu

# --- Redis (cache, sessions, Celery broker) ---
# Separate logical databases so flushing the cache never drops queued work.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (consumed from Week 3) ---
JWT_SECRET=changeme-in-local-env
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI & Edge ML engine (consumed from Week 9) ---
# MedGemma over HTTP: an Ollama container locally, a hosted endpoint in prod.
MEDGEMMA_MODEL=medgemma
MEDGEMMA_BASE_URL=http://localhost:11434
MEDGEMMA_API_KEY=changeme-in-local-env
# 0.0 -- the same symptoms must not produce different medical guidance.
MEDGEMMA_TEMPERATURE=0.0

# whisper.cpp, run on-device for Nepali voice input.
WHISPER_CPP_BINARY=/usr/local/bin/whisper-cli
WHISPER_MODEL_PATH=/models/ggml-base-q5_1.bin
WHISPER_LANGUAGE=ne

# Localized Nepali text-to-speech for audio narration.
TTS_ENGINE=piper
TTS_MODEL_PATH=/models/ne_NP-voice.onnx

# --- WebRTC (consumed from Week 13) ---
# Comma-separated. TURN relays media when peers cannot connect directly.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:localhost:3478
TURN_USERNAME=swasthyasetu
TURN_CREDENTIAL=changeme-in-local-env
