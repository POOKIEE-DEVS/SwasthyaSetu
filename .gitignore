# Secrets live here; only .env.example files are committed
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Go build output
/backend/server
/backend/server.exe
/backend/bin/

# Python (the model server and the smoke test)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Model weights are downloaded by the Space, never committed.
*.gguf
*.safetensors
*.onnx

# Editors & OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Gradio local cache (share-link certificates, flagged data)
.gradio/

# Local development database (production uses Postgres via DATABASE_URL)
*.db
*.db-journal
